import {
  "moonbitlang/async",
  "wzzc-dev/moui/backend/linux" @linux_backend,
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui_skia_renderer" @render_skia,
  "wzzc-dev/moui_webview/backend/linux" @linux_webview,
  "wzzc-dev/moui_webview/host" @webview_host,
  "deepseek_harness_desktop/app",
  "deepseek_harness_desktop/app/dsh_async",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
