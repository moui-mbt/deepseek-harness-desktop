import {
  "moonbitlang/async",
  "wzzc-dev/moui/backend/macos" @macos_backend,
  "wzzc-dev/moui_skia_renderer" @render_skia,
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui_webview/backend/macos" @macos_webview,
  "wzzc-dev/moui_webview/host" @webview_host,
  "deepseek_harness_desktop/app",
  "deepseek_harness_desktop/app/dsh_async",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "pre-build": [
    {
      "command": ":embed --text --input $input --output $output --name dsh_shell_patch_css",
      "input": "dsh_shell_patch.css",
      "output": "dsh_shell_patch_css.mbt",
    },
    {
      "command": ":embed --text --input $input --output $output --name dsh_shell_patch_js",
      "input": "dsh_shell_patch.js",
      "output": "dsh_shell_patch_js.mbt",
    },
  ],
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
